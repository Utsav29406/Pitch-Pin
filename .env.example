# Copy to .env.local (Next.js) and .env (Prisma CLI). Never commit real values.
# Leave DATABASE_URL empty to run the UI in demo mode with sample turfs.

# --- Neon Postgres (added by the Vercel Neon integration; `vercel env pull .env.development.local`) ---
# Pooled connection used by the app
DATABASE_URL=
# Direct connection used by `prisma migrate`
DATABASE_URL_UNPOOLED=

# --- Razorpay (Dashboard > Account & Settings > API keys / Webhooks) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Inngest (app.inngest.com > Manage > Keys). Not needed with `npx inngest-cli dev` ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Misc ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/cron/expire-holds (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Admin console address (defaults to pitchpin-admin.vercel.app; admin.localhost works locally)
# ADMIN_HOST=pitchpin-admin.vercel.app

# "Continue with Google": Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URIs: https://pitchpins.vercel.app/api/auth/google/callback and http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (welcome, booking confirmed) are sent from this Gmail account via an App Password
# (Google Account → Security → 2-Step Verification → App passwords). Empty = emails are skipped.
GMAIL_USER=teampitchpinn@gmail.com
GMAIL_APP_PASSWORD=

# Resend (preferred over Gmail when set). Without your own verified domain, Resend only sends
# from onboarding@resend.dev and only delivers to the email address of your Resend account.
RESEND_API_KEY=
# RESEND_FROM=PitchPin <bookings@your-domain.com>
