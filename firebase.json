{
  "hosting": {
    "site": "pitchpin",
    "public": "firebase-backup/public",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/login",
        "destination": "https://pitchpins.vercel.app/login",
        "type": 302
      },
      {
        "source": "/account{,/**}",
        "destination": "https://pitchpins.vercel.app/account",
        "type": 302
      },
      {
        "source": "/bookings{,/**}",
        "destination": "https://pitchpins.vercel.app/bookings",
        "type": 302
      },
      {
        "source": "/checkout/**",
        "destination": "https://pitchpins.vercel.app/bookings",
        "type": 302
      },
      {
        "source": "/owner{,/**}",
        "destination": "https://pitchpins.vercel.app/owner",
        "type": 302
      },
      {
        "source": "/pay/**",
        "destination": "https://pitchpins.vercel.app/bookings",
        "type": 302
      },
      {
        "source": "/admin{,/**}",
        "destination": "https://pitchpin-admin.vercel.app",
        "type": 302
      },
      {
        "source": "/api/:path*",
        "destination": "https://pitchpins.vercel.app/api/:path",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
